#!/usr/bin/env bash
# Keep the idle locker alive throughout i3, then stop it before X teardown.
set -u
locker_pid=
wm_pid=
session_started=0
cleanup() {
    trap - EXIT HUP INT TERM
    for child in "$locker_pid" "$wm_pid"; do
        [[ -n "$child" ]] || continue
        kill -TERM "$child" 2>/dev/null || true
        wait "$child" 2>/dev/null || true
    done
    if [[ "$session_started" == 1 ]]; then
        systemctl --user stop vigilos-i3-session.target || true
    fi
}
trap cleanup EXIT
trap 'exit 0' HUP INT TERM
export QT_QPA_PLATFORMTHEME=gtk3
export XDG_CURRENT_DESKTOP=i3
dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP QT_QPA_PLATFORMTHEME
session_started=1
systemctl --user start vigilos-i3-session.target
export VIGIL_I3_LOCK_MANAGED=1
if ! /usr/local/libexec/vigilos-is-live; then
    xss-lock --transfer-sleep-lock -- /usr/local/bin/lock --nofork &
    locker_pid=$!
fi
i3 "$@" &
wm_pid=$!
wait "$wm_pid"
