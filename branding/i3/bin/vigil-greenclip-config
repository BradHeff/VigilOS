#!/usr/bin/python3
"""Create clean per-user Greenclip defaults; preserve an existing configuration."""
import json, os
from pathlib import Path
os.umask(0o077)
home = Path.home()
config = Path(os.environ.get('XDG_CONFIG_HOME', str(home / '.config'))) / 'greenclip.toml'
if config.exists():
    raise SystemExit(0)
cache = Path(os.environ.get('XDG_CACHE_HOME', str(home / '.cache'))) / 'greenclip'
images = cache / 'images'
images.mkdir(parents=True, mode=0o700, exist_ok=True)
config.parent.mkdir(parents=True, exist_ok=True)
settings = {
    'blacklisted_applications': [],
    'enable_image_support': True,
    'history_file': str(cache / 'history'),
    'image_cache_directory': str(images),
    'max_history_length': 50,
    'max_selection_size_bytes': 0,
    'static_history': [],
    'trim_space_from_selection': True,
    'use_primary_selection_as_input': False,
}
try:
    with config.open('x') as stream:
        stream.write('[greenclip]\n')
        for key, value in settings.items():
            stream.write(f'{key} = {json.dumps(value)}\n')
except FileExistsError:
    pass
