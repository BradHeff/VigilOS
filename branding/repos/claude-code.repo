# Anthropic's signed Claude Code repository, stable channel: https://code.claude.com/docs/en/setup
# Off until the user installs Claude Code from VIGIL Ask, which then turns it on for updates.
[claude-code]
name=Claude Code (Anthropic, stable)
baseurl=https://downloads.claude.ai/claude-code/rpm/stable
enabled=0
gpgcheck=1
repo_gpgcheck=1
sslverify=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-claude-code
includepkgs=claude-code
