#!/usr/bin/env bash
# Runs in the installed system, from Anaconda %post or on first boot.
set -euo pipefail
[[ -s /etc/vigilos-release && -s /etc/fstab && -d /boot/grub2 ]] || { echo 'Installed VIGIL target required' >&2; exit 1; }
# Skip first-boot account setup if Anaconda already created a user.
if getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $1 != "liveuser" && $7 !~ /(nologin|false)$/ {found=1} END {exit !found}'; then
    touch /etc/plasma-setup-done
    restorecon /etc/plasma-setup-done
fi
# Anaconda rewrites /etc/default/grub, so restore the theme.
mkdir -p /boot/grub2/themes/vigilos
cp -a /usr/share/grub/themes/vigilos/. /boot/grub2/themes/vigilos/
sed -i '/^GRUB_THEME=/d;/^GRUB_TERMINAL_OUTPUT=/d;/^GRUB_DISTRIBUTOR=/d;/^GRUB_GFXMODE=/d;/^GRUB_GFXPAYLOAD_LINUX=/d;/^GRUB_FONT=/d' /etc/default/grub
cat >> /etc/default/grub <<'INSTALLED_GRUB'
GRUB_DISTRIBUTOR="VIGIL OS"
GRUB_TERMINAL_OUTPUT="gfxterm"
GRUB_THEME="/boot/grub2/themes/vigilos/theme.txt"
GRUB_FONT="/boot/grub2/themes/vigilos/unicode.pf2"
GRUB_GFXPAYLOAD_LINUX=keep
INSTALLED_GRUB
if [[ -d /sys/firmware/efi ]]; then
    printf 'GRUB_GFXMODE=auto\n' >> /etc/default/grub
else
    printf 'GRUB_GFXMODE=1280x800,1024x768,800x600,auto\n' >> /etc/default/grub
fi
# Boot the newest kernel once, not the live image's; later choices are kept.
if [[ ! -e /var/lib/vigilos-initial-kernel-selected ]]; then
    latest_kernel="$(rpm -q kernel-core --qf '%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort -V | tail -n1)"
    [[ -n "$latest_kernel" && -s "/boot/vmlinuz-$latest_kernel" ]] || { echo 'Installed kernel missing' >&2; exit 1; }
    grubby --set-default "/boot/vmlinuz-$latest_kernel"
    touch /var/lib/vigilos-initial-kernel-selected
    restorecon /var/lib/vigilos-initial-kernel-selected
fi
grub2-mkconfig -o /boot/grub2/grub.cfg
for path in /etc/sddm.conf.d /etc/lightdm /var/lib/AccountsService /boot; do
    [[ ! -e "$path" ]] || restorecon -RF "$path"
done
