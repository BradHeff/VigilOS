#!/usr/bin/python3
"""Unprivileged, ephemeral Brave viewer for Anaconda's supported command engine."""
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import threading


def main():
    url_prefix = 'http://127.0.0.1/cockpit/@localhost/anaconda-webui/index.html'
    if os.geteuid() == 0 or len(sys.argv) != 2 or not sys.argv[1].startswith(url_prefix):
        raise SystemExit('Desktop user and local installer URL required')
    runtime = Path(os.environ['XDG_RUNTIME_DIR'])
    if not runtime.is_dir() or runtime.stat().st_uid != os.geteuid():
        raise SystemExit('Owned desktop runtime directory required')
    # Resolve the native executable from the official RPM launcher location. Its
    # shell wrapper masks failures and can orphan its child when Anaconda exits.
    wrapper = Path('/usr/bin/brave-browser').resolve(strict=True)
    binary = wrapper.parent / 'brave'
    if not binary.is_file() or not os.access(binary, os.X_OK):
        raise SystemExit('Official Brave native executable missing')
    profile = Path(tempfile.mkdtemp(prefix='vigilos-installer-brave.', dir=runtime))
    child = None
    requested_stop = False

    def stop(signum, frame):
        nonlocal requested_stop
        requested_stop = True
        if child is not None and child.poll() is None:
            child.terminate()  # Main browser only; let it close its own children.

    for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(signum, stop)
    try:
        # No normal user profile, wallet or policy is changed. This private
        # runtime-only installer profile never saves credentials or analytics.
        (profile / 'Local State').write_text(json.dumps({
            'brave': {'p3a': {'enabled': False, 'notice_acknowledged': True}}
        }))
        (profile / 'Default').mkdir(mode=0o700)
        (profile / 'Default/Preferences').write_text(json.dumps({
            'credentials_enable_service': False,
            'credentials_enable_passkeys': False,
            'credentials_enable_autosignin': False
        }))
        env = dict(os.environ, CHROME_WRAPPER=str(wrapper),
                   CHROME_VERSION_EXTRA='stable',
                   GNOME_DISABLE_CRASH_DIALOG='SET_BY_GOOGLE_CHROME')
        child = subprocess.Popen([
            str(binary), '--password-store=basic', f'--user-data-dir={profile}',
            '--no-first-run', '--no-default-browser-check', '--start-maximized',
            '--ozone-platform=wayland', f'--app={sys.argv[1]}'
        ], env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT, close_fds=True, bufsize=0)
        # Only fresh pipes are inherited by sandboxed browser children. Preserve
        # useful diagnostics without exposing the launcher's original terminal.
        def relay():
            while data := child.stdout.read(4096):
                try:
                    os.write(2, data)
                except OSError:
                    break
        threading.Thread(target=relay, daemon=True).start()
        if requested_stop:
            child.terminate()
        result = child.wait()
        if requested_stop:
            return 0
        return result if result >= 0 else 128 - result
    finally:
        if child is not None and child.poll() is None:
            child.terminate()
            try:
                child.wait(timeout=5)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait()
        shutil.rmtree(profile)


if __name__ == '__main__':
    sys.exit(main())
