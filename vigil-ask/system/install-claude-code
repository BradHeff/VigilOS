#!/usr/bin/bash
# Run by VIGIL Ask through pkexec: install Claude Code and keep its repository on for updates.
set -euo pipefail
[[ $EUID == 0 ]] || { echo 'Run this through pkexec.' >&2; exit 1; }
repo=/etc/yum.repos.d/claude-code.repo
for setting in gpgcheck=1 repo_gpgcheck=1 gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-claude-code; do
    grep -qx "$setting" "$repo" || { echo "$repo must keep $setting." >&2; exit 1; }
done
dnf -y install --enablerepo=claude-code claude-code
dnf config-manager setopt claude-code.enabled=1
